# FAUMAIL
# First section: remote IMAP account
IMAPAccount faumail
Host faumail.fau.de
Port 993
User markus.pirke@fau.de
# For simplicity, this is how to read the password from another file.
# For better security you should use GPG https://gnupg.org/
PassCmd "Pass show FAU/markus.pirke@fau.de"
SSLType IMAPS
SSLVersions TLSv1.2

IMAPStore faumail-remote
Account faumail

# This section describes the local storage
MaildirStore faumail-local
Path ~/Mail/FAU/
Inbox ~/Mail/FAU/INBOX
# The SubFolders option allows to represent all
# IMAP subfolders as local subfolders
SubFolders Verbatim

# This section a "channel", a connection between remote and local
Channel faumail
Far :faumail-remote:
Near :faumail-local:
Patterns *
Expunge Both
CopyArrivalDate yes
Sync All
Create Slave
SyncState *

# PRIVATE MAIL
# First section: remote IMAP account
IMAPAccount icloud
Host imap.mail.me.com
Port 993
User markus.pirke@icloud.com
PassCmd "Pass show Privat/icloud-mail-app-specific"
#PassCmd "echo "
SSLType IMAPS
SSLVersions TLSv1.2
AuthMechs PLAIN

IMAPStore icloud-remote
Account icloud

# This section describes the local storage
MaildirStore icloud-local
Path ~/Mail/iCloud/
Inbox ~/Mail/iCloud/INBOX
# The SubFolders option allows to represent all
# IMAP subfolders as local subfolders
SubFolders Verbatim

# This section a "channel", a connection between remote and local
Channel icloud
Far :icloud-remote:
Near :icloud-local:
Patterns *
Expunge Both
CopyArrivalDate yes
Sync All
Create Slave
SyncState *
