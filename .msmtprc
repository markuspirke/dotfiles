defaults
port 587
tls on
tls_starttls on

account icloud
host smtp.mail.me.com
from markus.pirke@icloud.com
user markus.pirke@icloud.com
auth on
passwordeval Pass show Privat/icloud-mail-app-specific

account fau
host smtp-auth.fau.de
from markus.pirke@fau.de
user markus.pirke@fau.de
auth on
passwordeval Pass show pass FAU/markus.pirke@fau.de

account default : icloud
